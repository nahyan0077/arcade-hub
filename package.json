{
  "name": "arcade-hub",
  "version": "0.0.0",
  "description": "Tic-tac-toe arcade: local, vs AI, or online with matchmaking and voice chat",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nahyan0077/arcade-hub.git"
  },
  "bugs": {
    "url": "https://github.com/nahyan0077/arcade-hub/issues"
  },
  "homepage": "https://github.com/nahyan0077/arcade-hub#readme",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "typecheck:cf": "tsc -p tsconfig.cloudflare.json",
    "test:e2e": "playwright test",
    "test:e2e:ws": "E2E_PORT=5200 VITE_WS_URL=ws://127.0.0.1:8787 playwright test e2e/online.spec.ts e2e/matchmake.spec.ts",
    "test:e2e:cf": "E2E_WS=cf E2E_PORT=5202 VITE_WS_URL=ws://127.0.0.1:8788 playwright test e2e/online.spec.ts e2e/matchmake.spec.ts",
    "test:e2e:voice": "bash scripts/e2e-voice.sh",
    "relay": "node server/relay.ts",
    "relay:cf": "WRANGLER_SEND_METRICS=false wrangler dev --port 8788"
  },
  "dependencies": {
    "livekit-client": "^2.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@eslint/js": "^9.9.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/ui": "^2.1.8",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1",
    "vitest": "^2.1.8",
    "wrangler": "^4.151.1",
    "ws": "^8.22.0"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tic-tac-toe-relay",
  "main": "cloudflare/relay.ts",
  "compatibility_date": "2025-09-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomRelay"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomRelay"]
    }
  ],
  "dev": {
    "port": 8788
  }
}

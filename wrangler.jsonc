{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "arcade-hub-relay",
  "main": "cloudflare/relay.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "RoomRelay"
      },
      {
        "name": "MATCHMAKER",
        "class_name": "Matchmaker"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomRelay"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["Matchmaker"]
    }
  ],
  "dev": {
    "port": 8788
  }
}
